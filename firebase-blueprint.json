{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with personal, dating preferences, verification, and privacy settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique auth UID of the user" },
        "username": { "type": "string", "description": "Public handle / username" },
        "displayName": { "type": "string", "description": "Public name or nickname" },
        "photoUrl": { "type": "string", "description": "Avatar/profile photo URL or compact JPEG data URI" },
        "coverPhotoUrl": { "type": "string", "description": "Profile cover banner photo URL or compact JPEG data URI" },
        "birthday": { "type": "string", "description": "Birthday in YYYY-MM-DD format" },
        "age": { "type": "integer", "description": "Age of user automatically calculated from birthday, 18+ required" },
        "gender": { "type": "string", "description": "Gender identity" },
        "country": { "type": "string", "description": "Country of residence" },
        "city": { "type": "string", "description": "Optional city" },
        "aboutMe": { "type": "string", "description": "Personal bio and about me" },
        "personality": { "type": "string", "description": "Personality archetype or traits" },
        "hobbies": { "type": "array", "description": "List of member hobbies" },
        "interests": { "type": "array", "description": "List of user interests" },
        "lookingFor": { "type": "string", "description": "Relationship or friendship goal" },
        "preferredGender": { "type": "string", "description": "Preferred match gender (ALL, Female, Male, Non-Binary)" },
        "preferredMinAge": { "type": "integer", "description": "Minimum preferred match age (18+)" },
        "preferredMaxAge": { "type": "integer", "description": "Maximum preferred match age" },
        "preferredCountry": { "type": "string", "description": "Preferred match country or ALL" },
        "isOnline": { "type": "boolean", "description": "Whether user is currently active" },
        "isVerifiedMember": { "type": "boolean", "description": "Owner-verified member badge status" },
        "verificationStatus": { "type": "string", "enum": ["NONE", "PENDING", "VERIFIED"], "description": "Member verification review state" },
        "accountStatus": { "type": "string", "enum": ["ACTIVE", "SUSPENDED"], "description": "Owner-managed moderation status" },
        "hideFromDiscovery": { "type": "boolean", "description": "Privacy setting to exclude profile from discovery carousels" },
        "hideOnlineStatus": { "type": "boolean", "description": "Privacy setting to hide online green indicator" },
        "hideAge": { "type": "boolean", "description": "Privacy setting to hide age on profile card" },
        "hideLocation": { "type": "boolean", "description": "Privacy setting to hide city/location" },
        "role": { "type": "string", "enum": ["member"], "description": "User role, defaults to member and cannot be escalated" },
        "lastActive": { "type": "string", "format": "date-time", "description": "Timestamp of last presence heartbeat" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account profile creation time" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last profile update time" }
      },
      "required": ["userId", "displayName", "age", "gender", "country", "createdAt", "updatedAt"]
    },
    "GalleryPhoto": {
      "title": "GalleryPhoto",
      "description": "Member personal gallery photo stored in user subcollection",
      "type": "object",
      "properties": {
        "photoId": { "type": "string" },
        "userId": { "type": "string" },
        "photoUrl": { "type": "string" },
        "caption": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["photoId", "userId", "photoUrl", "createdAt"]
    },
    "UserPresence": {
      "title": "UserPresence",
      "description": "Real-time online status and last seen timestamp for a member",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "isOnline", "lastSeen", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct chat thread between two members including unread counters and typing status",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "participantUids": { "type": "array" },
        "lastMessage": { "type": "string" },
        "lastMessageSenderId": { "type": "string" },
        "unreadCountByUid": { "type": "object" },
        "typingByUid": { "type": "object" },
        "lastMessageTimestamp": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "participantUids", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual chat message within a conversation (text, image, sticker, voice)",
      "type": "object",
      "properties": {
        "messageId": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "participantUids": { "type": "array" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["TEXT", "IMAGE", "VOICE", "STICKER"] },
        "mediaUrl": { "type": "string" },
        "isRead": { "type": "boolean" },
        "reactions": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["messageId", "conversationId", "senderId", "receiverId", "participantUids", "content", "type", "createdAt"]
    },
    "UserBlock": {
      "title": "UserBlock",
      "type": "object",
      "properties": {
        "blockId": { "type": "string" },
        "blockerId": { "type": "string" },
        "blockedId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["blockId", "blockerId", "blockedId", "createdAt"]
    },
    "UserReport": {
      "title": "UserReport",
      "type": "object",
      "properties": {
        "reportId": { "type": "string" },
        "reporterId": { "type": "string" },
        "reportedId": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "REVIEWED", "DISMISSED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reportId", "reporterId", "reportedId", "reason", "createdAt"]
    },
    "ContentReport": {
      "title": "ContentReport",
      "type": "object",
      "properties": {
        "reportId": { "type": "string" },
        "reporterId": { "type": "string" },
        "reportedUserId": { "type": "string" },
        "conversationId": { "type": "string" },
        "messageId": { "type": "string" },
        "messageType": { "type": "string", "enum": ["TEXT", "IMAGE", "VOICE", "STICKER"] },
        "messageExcerpt": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "REVIEWED", "DISMISSED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reportId", "reporterId", "reportedUserId", "conversationId", "messageId", "messageType", "messageExcerpt", "reason", "status", "createdAt"]
    },
    "ActivityReport": {
      "title": "ActivityReport",
      "type": "object",
      "properties": {
        "reportId": { "type": "string" },
        "reporterId": { "type": "string" },
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "postExcerpt": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "REVIEWED", "DISMISSED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reportId", "reporterId", "postId", "authorId", "postExcerpt", "reason", "status", "createdAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string" },
        "userId": { "type": "string" },
        "senderId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string", "enum": ["CHAT_MESSAGE", "PROFILE_VISIT", "PROFILE_LIKE", "FRIEND_REQUEST", "SAY_HI", "SYSTEM"] },
        "data": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["notificationId", "userId", "title", "body", "type", "isRead", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "type": "object",
      "properties": {
        "requestId": { "type": "string" },
        "requesterId": { "type": "string" },
        "recipientId": { "type": "string" },
        "participantUids": { "type": "array" },
        "status": { "type": "string", "enum": ["PENDING", "ACCEPTED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "requesterId", "recipientId", "participantUids", "status", "createdAt", "updatedAt"]
    },
    "FollowRecord": {
      "title": "FollowRecord",
      "type": "object",
      "properties": {
        "followId": { "type": "string" },
        "followerId": { "type": "string" },
        "followingId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followId", "followerId", "followingId", "createdAt"]
    },
    "FavoriteRecord": {
      "title": "FavoriteRecord",
      "type": "object",
      "properties": {
        "favoriteId": { "type": "string" },
        "userId": { "type": "string" },
        "targetUserId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["favoriteId", "userId", "targetUserId", "createdAt"]
    },
    "ProfileLikeRecord": {
      "title": "ProfileLikeRecord",
      "type": "object",
      "properties": {
        "likeId": { "type": "string" },
        "likerId": { "type": "string" },
        "likedUserId": { "type": "string" },
        "likerName": { "type": "string" },
        "likerPhotoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["likeId", "likerId", "likedUserId", "createdAt"]
    },
    "ProfileVisitorRecord": {
      "title": "ProfileVisitorRecord",
      "type": "object",
      "properties": {
        "visitId": { "type": "string" },
        "visitorId": { "type": "string" },
        "visitedUserId": { "type": "string" },
        "visitorName": { "type": "string" },
        "visitorPhotoUrl": { "type": "string" },
        "visitedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["visitId", "visitorId", "visitedUserId", "visitorName", "visitedAt"]
    },
    "CallSession": {
      "title": "CallSession",
      "type": "object",
      "properties": {
        "callId": { "type": "string" },
        "callerId": { "type": "string" },
        "callerName": { "type": "string" },
        "callerPhotoUrl": { "type": "string" },
        "calleeId": { "type": "string" },
        "calleeName": { "type": "string" },
        "calleePhotoUrl": { "type": "string" },
        "participantUids": { "type": "array" },
        "callType": { "type": "string", "enum": ["VIDEO", "AUDIO"] },
        "status": { "type": "string", "enum": ["RINGING", "ANSWERED", "DECLINED", "ENDED"] },
        "offerSdp": { "type": "string" },
        "answerSdp": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["callId", "callerId", "callerName", "calleeId", "calleeName", "participantUids", "callType", "status", "offerSdp", "createdAt", "updatedAt"]
    },
    "IceCandidate": {
      "title": "IceCandidate",
      "type": "object",
      "properties": {
        "candidateId": { "type": "string" },
        "senderId": { "type": "string" },
        "participantUids": { "type": "array" },
        "sdpMid": { "type": "string" },
        "sdpMLineIndex": { "type": "integer" },
        "candidate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["candidateId", "senderId", "participantUids", "sdpMid", "sdpMLineIndex", "candidate", "createdAt"]
    },
    "ActivityPost": {
      "title": "ActivityPost",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorPhotoUrl": { "type": "string" },
        "authorCity": { "type": "string" },
        "authorCountry": { "type": "string" },
        "authorVerified": { "type": "boolean" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "moodEmoji": { "type": "string" },
        "activityTag": { "type": "string" },
        "reactionCounts": { "type": "object" },
        "totalReactions": { "type": "integer" },
        "commentCount": { "type": "integer" },
        "shareCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "authorId", "authorName", "content", "moodEmoji", "activityTag", "reactionCounts", "totalReactions", "createdAt", "updatedAt"]
    },
    "ActivityReaction": {
      "title": "ActivityReaction",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "postId": { "type": "string" },
        "emoji": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "postId", "emoji", "updatedAt"]
    },
    "ActivityComment": {
      "title": "ActivityComment",
      "type": "object",
      "properties": {
        "commentId": { "type": "string" },
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhotoUrl": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["commentId", "postId", "authorId", "authorName", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/UserProfile" } },
    "/users/{userId}/activity_reactions/{postId}": { "schema": { "$ref": "#/entities/ActivityReaction" } },
    "/users/{userId}/gallery_photos/{photoId}": { "schema": { "$ref": "#/entities/GalleryPhoto" } },
    "/user_presence/{userId}": { "schema": { "$ref": "#/entities/UserPresence" } },
    "/conversations/{conversationId}": { "schema": { "$ref": "#/entities/Conversation" } },
    "/conversations/{conversationId}/messages/{messageId}": { "schema": { "$ref": "#/entities/Message" } },
    "/user_blocks/{blockId}": { "schema": { "$ref": "#/entities/UserBlock" } },
    "/blocks/{blockId}": { "schema": { "$ref": "#/entities/UserBlock" } },
    "/user_reports/{reportId}": { "schema": { "$ref": "#/entities/UserReport" } },
    "/reports/{reportId}": { "schema": { "$ref": "#/entities/UserReport" } },
    "/content_reports/{reportId}": { "schema": { "$ref": "#/entities/ContentReport" } },
    "/activity_reports/{reportId}": { "schema": { "$ref": "#/entities/ActivityReport" } },
    "/notifications/{notificationId}": { "schema": { "$ref": "#/entities/UserNotification" } },
    "/friend_requests/{requestId}": { "schema": { "$ref": "#/entities/FriendRequest" } },
    "/user_follows/{followId}": { "schema": { "$ref": "#/entities/FollowRecord" } },
    "/user_favorites/{favoriteId}": { "schema": { "$ref": "#/entities/FavoriteRecord" } },
    "/profile_likes/{likeId}": { "schema": { "$ref": "#/entities/ProfileLikeRecord" } },
    "/profile_visits/{visitId}": { "schema": { "$ref": "#/entities/ProfileVisitorRecord" } },
    "/call_sessions/{callId}": { "schema": { "$ref": "#/entities/CallSession" } },
    "/call_sessions/{callId}/candidates/{candidateId}": { "schema": { "$ref": "#/entities/IceCandidate" } },
    "/activity_posts/{postId}": { "schema": { "$ref": "#/entities/ActivityPost" } },
    "/activity_posts/{postId}/comments/{commentId}": { "schema": { "$ref": "#/entities/ActivityComment" } }
  }
}
